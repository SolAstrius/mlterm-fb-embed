top_builddir = ../..
top_srcdir = @top_srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@

VPATH = ${top_srcdir}/tool/fb-dumper

CC = @CC@
LIBTOOL = @LIBTOOL@
INSTALL = @INSTALL@
BINDIR = $(DESTDIR)$(bindir)

# Compile flags mirror main/Makefile.in's fb path; the embed CFLAGS
# variable carries -DUSE_FB_EMBED so the embed-API header exposes
# the entry points we link against.
# Path to the vendored Cozette BDF, baked into main.o as a macro so
# the dumper writes it into ~/.mlterm/font-fb at startup. Kept as a
# separate variable to avoid quoting interactions with autoconf's
# sed-driven Makefile.in substitution (single quotes plus $(...)
# refs in the CFLAGS line trip up substitution and silently truncate
# the generated Makefile).
# abspath turns the in-tree relative path into an absolute one at
# build time so the macro the dumper bakes in works no matter what
# cwd the dumper is run from. (The dumper realpaths it again at
# startup but we want this to also work pre-install in a build
# tree, where the build is happening under top_srcdir.)
COZETTE_PATH = $(abspath $(top_srcdir)/vendor/cozette/cozette.pcf)
COZETTE_DEFINE = -DCOZETTE_OTB_PATH=\"$(COZETTE_PATH)\"

CFLAGS = $(CFLAGS_LOCAL) @POBL_CFLAGS@ @MEF_CFLAGS@ @DEB_CFLAGS@ \
	@TYPE_CFLAGS@ @FT_CFLAGS@ @TRUECOLOR_CFLAGS@ @FB_EMBED_CFLAGS@ \
	@CFLAGS@ @CPPFLAGS@ $(COZETTE_DEFINE) \
	-I$(top_srcdir)/baselib/src -I$(top_srcdir)/encodefilter/src \
	-I$(top_srcdir)/vtemu -I$(top_srcdir)/uitoolkit

# Link inputs: same shape as main/Makefile.in's fb mode. Static
# archives produced by the in-tree builds, linked through libtool
# so the libpobl/libmef shared-library handling works. We pull in
# main_loop.o + daemon.o from main/ since the dumper drives mlterm's
# normal init path rather than rebuilding it.
LMLTERM = ../../vtemu/libmlterm@TRUECOLOR_TAG@.a ../../vtemu/@LMLTERM_CORE@
LUITK = ../../uitoolkit/libuitoolkit.a
LMAIN = ../../main/main_loop.o ../../main/daemon.o
LIBS = $(LMAIN) $(LUITK) $(LMLTERM) @LMEF@ @LPOBL@ \
	@MATH_LIBS@ @DL_LIBS_IM@ @DL_LIBS_SB@ @FT_LIBS@ @SOCK_LIBS@ \
	@PTHREAD_LIB@ @SSH2_LIBS_FOR_PROG@ @REGEX_LIBS@

LIBTOOL_LINK = $(LIBTOOL) --mode=link $(CC) @LDFLAGS@

OBJ = main.o
PROG = mlterm-fb-dumper

all: $(PROG)

$(PROG): $(OBJ) $(LMLTERM) $(LUITK) $(LMAIN)
	$(LIBTOOL_LINK) -o $(PROG) $(OBJ) $(LIBS)

.SUFFIXES: .c.o

.c.o:
	$(CC) $(CFLAGS) -c $<

clean:
	rm -f $(OBJ) $(PROG)

install: $(PROG)
	mkdir -p $(BINDIR)
	$(INSTALL) -m 755 $(PROG) $(BINDIR)/$(PROG)

uninstall:
	rm -f $(BINDIR)/$(PROG)
